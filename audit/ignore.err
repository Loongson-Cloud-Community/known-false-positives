Error: SHELLCHECK_WARNING:
/usr/libexec/initscripts/legacy-actions/auditd/state:16:6: warning[SC3037]: In POSIX sh, echo flags are undefined.
#   14|   killproc $prog -CONT
#   15|   RETVAL=$?
#   16|-> echo -e "\n"
#   17|   sleep 1
#   18|   if [ $? -eq 0 ] ; then
echo -e is undefined in POSIX but works in the shells actually used on Linux, and the line only prints a newline.

